modules = ["nodejs-20", "web", "bash", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 26227
externalPort = 3000

[objectStorage]
defaultBucketID = "replit-objstore-1b1aca84-5e87-4067-a5b9-4032695c1b44"

[userenv]

[userenv.shared]
MARKETPLACE_PROVIDER_URL = "https://tokenharvest.ke/api/provider/marketplace/v1"
